<Window x:Class="_1_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_1_project"
        mc:Ignorable="d"
        Title="Moja pierwsza apliakcja WPF" Height="500" Width="900">
    <Grid>
        <TextBlock Text="Imię i nazwisko:" HorizontalAlignment="Left" Margin="100, 100, 0, 0"/>
        <TextBox x:Name="txtStudent" Width="250" Height="30" HorizontalAlignment="Left" Margin="250, 95, 0, 0"/>

        <TextBlock Text="Klasa:" HorizontalAlignment="Left" Margin="100, 160, 0, 0"/>
        <TextBox x:Name="txtClass" Width="250" Height="30" HorizontalAlignment="Left" Margin="250, 155, 0, 0"/>

        <Button Width="150" Height="40" HorizontalAlignment="Left" Margin="250, 220, 0, 0" Click="btnShow_Click">
            <CheckBox Content="CheckBox" Checked="CheckBox_Checked"/>
        </Button>
    </Grid>
</Window>
